PORT=5000
NODE_ENV=development

# 1. Supabase PostgreSQL Database (IPv4 Pooler for ap-northeast-1)
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project_ref>.supabase.co

# 2. Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 3. JWT & Admin Authentication
JWT_SECRET=your_jwt_secret_key
ADMIN_EMAIL=admin@truthfoundation.org
ADMIN_PASSWORD=your_secure_password

# 4. CORS Whitelist
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# 5. Razorpay Gateway
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
