# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/teeszone/backend"
PassengerBaseURI "/api"
PassengerNodejs "/home/teeszone/nodevenv/backend/20/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. DO NOT rewrite /api or /admin requests to SPA index.html
  RewriteCond %{REQUEST_URI} ^/api [NC,OR]
  RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/admin [NC,OR]
  RewriteCond %{REQUEST_URI} ^/admin/ [NC]
  RewriteRule ^ - [L]

  # 2. React SPA single-page routing for all static page routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
